{% load static %}{
    "name": "IndependentRecruiters: Recruiter pricing",
    "short_name": "Recruiters",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "background_color": "#f1f5f9",
    "theme_color": "#0f172a",
    "icons": [
        {"src": "{% static 'core/icons/icon.svg' %}", "sizes": "any", "type": "image/svg+xml", "purpose": "any"},
        {"src": "{% static 'core/icons/icon-192.png' %}", "sizes": "192x192", "type": "image/png", "purpose": "any"},
        {"src": "{% static 'core/icons/icon-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "any"},
        {"src": "{% static 'core/icons/icon-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
    ]
}
